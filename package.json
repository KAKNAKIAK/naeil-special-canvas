{
  "name": "naeil-special-canvas",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "contract:check": "node scripts/contracts.mjs check",
    "contract:sync": "node scripts/contracts.mjs sync",
    "prebuild": "npm run contract:sync && npm run contract:check",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
